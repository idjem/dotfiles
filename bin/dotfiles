#!/bin/bash

# Header logging
e_header() {
    printf "\n$(tput setaf 7)%s$(tput sgr0)\n" "$@"
}

# Success logging
e_success() {
    printf "$(tput setaf 64)✓ %s$(tput sgr0)\n" "$@"
}

# Error logging
e_error() {
    printf "$(tput setaf 1)x %s$(tput sgr0)\n" "$@"
}

# Warning logging
e_warning() {
    printf "$(tput setaf 136)! %s$(tput sgr0)\n" "$@"
}

# Test whether a command exists
# $1 - cmd to test
type_exists() {
    if [ $(type -P $1) ]; then
      return 0
    fi
    return 1
}

# Test whether a Homebrew formula is already installed
# $1 - formula name
# $2 - optional: "cask" if it's a cask
formula_exists() {
    local name=$1
    local is_cask=$2
    
    if [ "$is_cask" = "cask" ]; then
        # Check if installed via Homebrew
        if $(brew list --cask $name >/dev/null 2>&1); then
            printf "%s already installed (via Homebrew).\n" "$name"
            return 0
        fi
        # Check if app exists in /Applications (installed manually)
        # Convert cask name to app name (e.g., "alt-tab" -> "Alt Tab")
        local app_name=""
        case $name in
            "alt-tab") app_name="AltTab.app" ;;
            "iterm2") app_name="iTerm.app" ;;
            "rectangle") app_name="Rectangle.app" ;;
            "jumpcut") app_name="Jumpcut.app" ;;
            "gather") app_name="Gather.app" ;;
            "cursor") app_name="Cursor.app" ;;
            *) app_name="${name^}.app" ;;
        esac
        
        if [ -d "/Applications/$app_name" ]; then
            printf "%s already installed (manually, not managed by Homebrew).\n" "$name"
            return 0
        fi
    else
        if $(brew list $name >/dev/null 2>&1); then
            printf "%s already installed.\n" "$name"
            return 0
        fi
    fi

    e_warning "Missing formula: $name"
    return 1
}

run_brew() {

    # Check for Homebrew
    if type_exists 'brew'; then
        e_header "Updating Homebrew..."
        # Use the latest version of Homebrew
        brew update
        [[ $? ]] && e_success "Done"

        e_header "Updating any existing Homebrew formulae..."
        # Upgrade any already-installed formulae
        brew upgrade
        [[ $? ]] && e_success "Done"

        e_header "Checking status of desired Homebrew formulae..."
        local -a missing_formulae
        local -a missing_casks
        local -a desired_formulae=(
            'git'
            'bash'
            'bash-completion'
            'tree'
            'wget'
        )
        local -a desired_casks=(
            'gather'
            'rectangle'
            'alt-tab'
            'iterm2'
            'jumpcut'
            'cursor'
        )

        # Check formulae
        for index in ${!desired_formulae[*]}
        do
            if ! formula_exists ${desired_formulae[$index]}; then
                missing_formulae=("${missing_formulae[@]}" "${desired_formulae[$index]}")
            fi
        done

        # Check casks
        for index in ${!desired_casks[*]}
        do
            if ! formula_exists ${desired_casks[$index]} "cask"; then
                missing_casks=("${missing_casks[@]}" "${desired_casks[$index]}")
            fi
        done

        # Install missing formulae
        if [[ "$missing_formulae" ]]; then
            e_header "Installing missing Homebrew formulae..."
            brew install "${missing_formulae[@]}"
            [[ $? ]] && e_success "Done"
        fi

        # Install missing casks
        if [[ "$missing_casks" ]]; then
            e_header "Installing missing Homebrew casks..."
            brew install --cask "${missing_casks[@]}"
            [[ $? ]] && e_success "Done"
        fi

        #install nvm
        curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.5/install.sh | bash

        # Remove outdated versions from the Cellar
        brew cleanup
    else
        printf "\n"
        e_error "Error: Homebrew not found."
        printf "Aborting...\n"
        exit
    fi

}

run_brew

# Install Cursor command in PATH
install_cursor_command() {
    if [ -d "/Applications/Cursor.app" ]; then
        e_header "Installing Cursor command in PATH..."
        if [ ! -L "/usr/local/bin/cursor" ]; then
            sudo ln -sf "/Applications/Cursor.app/Contents/Resources/app/bin/cursor" "/usr/local/bin/cursor"
            [[ $? ]] && e_success "Cursor command installed"
        else
            e_success "Cursor command already installed"
        fi
    fi
}

install_cursor_command


# Ask for confirmation before proceeding
seek_confirmation() {
    printf "\n"
    e_warning "$@"
    read -p "Continue? (y/n) " -n 1
    printf "\n"
}

# Test whether the result of an 'ask' is a confirmation
is_confirmed() {
    if [[ "$REPLY" =~ ^[Yy]$ ]]; then
      return 0
    fi
    return 1
}

DOTFILES_DIRECTORY="${HOME}/dvp/dotfiles"

link() {
    # Force create/replace the symlink.
    ln -fs "${DOTFILES_DIRECTORY}/${1}" "${HOME}/${2}"
}

mirrorfiles() {
    # Copy `.gitconfig`.
    # Any global git commands in `~/.bash_profile.local` will be written to
    # `.gitconfig`. This prevents them being committed to the repository.
    rsync -avz --quiet ${DOTFILES_DIRECTORY}/git/gitconfig  ${HOME}/.gitconfig

    # Force remove the vim directory if it's already there.
    if [ -e "${HOME}/.vim" ]; then
        rm -rf "${HOME}/.vim"
    fi

    # Create the necessary symbolic links between the `.dotfiles` and `HOME`
    # directory. The `bash_profile` sources other files directly from the
    # `.dotfiles` repository.
    link "shell/bashrc"       ".bashrc"
    link "shell/bash_profile" ".bash_profile"
    link "shell/curlrc"       ".curlrc"
    link "shell/inputrc"      ".inputrc"
    link "git/gitattributes"  ".gitattributes"
    link "git/gitignore"      ".gitignore"

    # Sync Cursor settings
    e_header "Syncing Cursor settings..."
    local cursor_user_dir="${HOME}/Library/Application Support/Cursor/User"
    
    # Create Cursor User directory if it doesn't exist
    if [ ! -d "${cursor_user_dir}" ]; then
        mkdir -p "${cursor_user_dir}"
    fi
    
    # Backup existing files if they exist and are not symlinks
    if [ -f "${cursor_user_dir}/settings.json" ] && [ ! -L "${cursor_user_dir}/settings.json" ]; then
        mv "${cursor_user_dir}/settings.json" "${cursor_user_dir}/settings.json.backup"
        e_warning "Backed up existing settings.json"
    fi
    
    if [ -f "${cursor_user_dir}/keybindings.json" ] && [ ! -L "${cursor_user_dir}/keybindings.json" ]; then
        mv "${cursor_user_dir}/keybindings.json" "${cursor_user_dir}/keybindings.json.backup"
        e_warning "Backed up existing keybindings.json"
    fi
    
    # Create symlinks for Cursor settings
    ln -sf "${DOTFILES_DIRECTORY}/cursor/settings.json" "${cursor_user_dir}/settings.json"
    ln -sf "${DOTFILES_DIRECTORY}/cursor/keybindings.json" "${cursor_user_dir}/keybindings.json"
    
    e_success "Cursor settings synced!"

    e_success "Dotfiles update complete!"
}

# Ask before potentially overwriting files
seek_confirmation "Warning: This step may overwrite your existing dotfiles."

if is_confirmed; then
    mirrorfiles
    source ${HOME}/.bash_profile
else
    printf "Aborting...\n"
    exit 1
fi

#!/bin/bash

# Vérification du nombre d'arguments
if [ "$#" -ne 1 ]; then
    echo "Usage: $0 SSO_ENV"
    exit 1
fi

# Récupération de l'argument du shell (SSO_ACCOUNT_ID)
SSO_ENV="$1"


# Obtention des credentials temporaires
temp_credentials=$(aws configure export-credentials --profile "selfcare-$SSO_ENV")

# Extraction des valeurs des credentials
aws_access_key_id=$(echo $temp_credentials | jq -r '.AccessKeyId')
aws_secret_access_key=$(echo $temp_credentials | jq -r '.SecretAccessKey')
aws_session_token=$(echo $temp_credentials | jq -r '.SessionToken')

# Exportation des credentials en tant que variables d'environnement
echo export AWS_DEFAULT_REGION=eu-west-3
echo export AWS_ACCESS_KEY_ID=$aws_access_key_id
echo export AWS_SECRET_ACCESS_KEY=$aws_secret_access_key
echo export AWS_SESSION_TOKEN=$aws_session_token

